{
  "name": "guessong",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w web && npm run build -w server",
    "start": "npm run start -w server",
    "ingest": "npm run ingest -w server",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs && node scripts/e2e-library.mjs",
    "typecheck": "tsc -p shared && tsc -p server && tsc -p web",
    "build-catalog": "npm run build-catalog -w server"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
