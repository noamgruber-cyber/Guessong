# Copy to .env and adjust. All values are optional unless noted.

# Which music source powers the game:
#   apple   – 30s previews from the free iTunes Search API (default, anyone can play)
#   spotify – full tracks via a Spotify Premium account (private use, see README)
#   mock    – offline demo catalog with synthesized audio (tests/demos)
MUSIC_PROVIDER=apple

# Public URL of the app (used for challenge links and the Spotify redirect URI).
# Dev default: http://127.0.0.1:5173 (set by `npm run dev`). Use https:// in production.
# PUBLIC_URL=https://guessong.example.com

# Required in production: 32+ random characters (signs cookies, encrypts Spotify tokens).
# SESSION_SECRET=

# PORT=8787
# HOST=0.0.0.0
# DATABASE_PATH=./server/data/guessong-apple.sqlite
# INGEST_ON_START=true

# --- Spotify ------------------------------------------------------------------
# From https://developer.spotify.com/dashboard (see README for the full setup).
# In apple (or mock) mode these turn on "Spotify games": players on the app's
# Spotify user list (max 5) build games from their own library, with Deezer previews.
# In spotify mode they're required, and songs play in full through Premium.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# Defaults to $PUBLIC_URL/api/v1/auth/spotify/callback; must match the dashboard exactly.
# SPOTIFY_REDIRECT_URI=
# SPOTIFY_MARKET=US
# Extra ms added to clips in Connect mode (phone app) to offset device start-up lag.
# SPOTIFY_CONNECT_COMP_MS=0

# --- Apple mode ---------------------------------------------------------------
# iTunes Search allows roughly 20 calls/min per IP; searches are cached.
# APPLE_SEARCH_PER_MINUTE=20
# Stream previews through the server so the URL can't reveal the song (recommended).
# AUDIO_PROXY=true

# --- Scoring ------------------------------------------------------------------
# Flat points deducted from a song's reward per hint used.
# HINT_PENALTIES={"artist":75,"song":100,"cover":85}
# SONG_HINT_UNLOCK_ATTEMPT=3
# MIN_POINTS_WITH_HINTS=5
